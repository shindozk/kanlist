{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.kanlist_k7q2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F1EE"
      }
    },
    "extra": {
      "apiUrl": "https://kanlist-jx0t6uu-preview-4200.runable.site/",
      "applicationId": "kanlist-jx0t6uu",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.kanlist-k7q2.runable",
      "supportsTablet": true
    },
    "name": "Kanlist",
    "slug": "kanlist",
    "version": "1.0.0",
    "scheme": "runable-kanlist-jx0t6uu",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F1EE",
          "imageWidth": 200
        }
      ]
    ]
  }
}
