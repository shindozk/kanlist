<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Kanlist" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_container_light</item>
        <item name="colorOnPrimary">@color/on_primary_light</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary_container_light</item>
        <item name="colorOnSecondary">@color/on_secondary_light</item>
        
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/tertiary_light</item>
        <item name="colorTertiaryVariant">@color/tertiary_container_light</item>
        <item name="colorOnTertiary">@color/on_tertiary_light</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">@color/on_error_light</item>
        
        <!-- Background -->
        <item name="colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/card_light</item>
        <item name="colorOnBackground">@color/foreground_light</item>
        <item name="colorOnSurface">@color/foreground_light</item>
        
        <!-- Custom colors -->
        <item name="colorPrimaryContainer">@color/primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_light</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Typography will be handled by Compose -->
    </style>

    <!-- Dark theme variant -->
    <style name="Theme.Kanlist.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_container_dark</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        
        <item name="colorSecondary">@color/secondary_dark</item>
        <item name="colorSecondaryVariant">@color/secondary_container_dark</item>
        <item name="colorOnSecondary">@color/on_secondary_dark</item>
        
        <item name="colorTertiary">@color/tertiary_dark</item>
        <item name="colorTertiaryVariant">@color/tertiary_container_dark</item>
        <item name="colorOnTertiary">@color/on_tertiary_dark</item>
        
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/on_error_dark</item>
        
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnBackground">@color/foreground_dark</item>
        <item name="colorOnSurface">@color/foreground_dark</item>
        
        <item name="colorPrimaryContainer">@color/primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_dark</item>
        
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Kanlist.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="postSplashScreenTheme">@style/Theme.Kanlist</item>
    </style>
</resources>